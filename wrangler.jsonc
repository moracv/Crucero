{
  // Worker único: sirve la PWA (carpeta dist) y la API /api/*
  "name": "crucero",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crucero",
      // Reemplazar con el id que devuelve: npx wrangler d1 create crucero
      "database_id": "be4acd93-a00b-401a-882c-0af8c18837c8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FOTOS", "bucket_name": "crucero-fotos" }],
  // Revisa los recordatorios pendientes cada 5 minutos y envía las notificaciones push
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    // ID de cliente OAuth de Google (tipo "Aplicación web")
    "GOOGLE_CLIENT_ID": "",
    // Correos autorizados separados por coma. Vacío = solo los 2 primeros usuarios que entren.
    "ALLOWED_EMAILS": "",
    // Clave pública VAPID (npm run vapid)
    "VAPID_PUBLIC_KEY": "BOW-ON-Je8oBYbSY8cOvPYhpoL6vM9dqHwK_tKvo_v9vyD9nrK_rx1KRGzC7FeQfHd4Jd7My3Uc-yFkxh29k-jQ",
    "VAPID_SUBJECT": "https://crucero.moracv.workers.dev"
  }
  // Secretos (npx wrangler secret put ...): SESSION_SECRET, VAPID_PRIVATE_JWK
}
